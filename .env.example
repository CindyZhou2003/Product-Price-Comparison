# 复制为 .env 并填写真实值，.env 不会被提交到 git

# 生成方式：python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1

DB_NAME=bs
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Gmail 需要开启两步验证后生成「应用专用密码」
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
